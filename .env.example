# Docker Compose Environment Configuration
# This file is loaded by docker-compose.yml via env_file directive.
# Sensitive secrets should be managed via Doppler, not here.
# Run `doppler init` and `doppler secrets set` to configure secrets.
# See README.md for full setup instructions.

# Application configuration
VERSION=<version>
NODE_ENV=<node-env>
HOST=<host>
PORT=<port>

# Database configuration (required for MongoDB container)
DATABASE_USER=<database-user>
DATABASE_HOST=<database-host>
DATABASE_PORT=<database-port>
DATABASE_NAME=<database-name>

# Doppler token for secrets management (set via environment, not here)
# DOPPLER_TOKEN=<your-doppler-token>

# Microservice configuration
EXAMPLE_MICROSERVICE_ENABLED=<example-microservice-enabled>
EXAMPLE_MICROSERVICE_HOST=<example-microservice-host>
EXAMPLE_MICROSERVICE_PORT=<example-microservice-port>
